{
  "schema_version": 1,
  "backend": "zimage",
  "python": ".venv/bin/python",
  "accelerate": ".venv/bin/accelerate",
  "accelerate_config": "configs/accelerate_ddp.yaml",
  "trainer": "src/train_dopcd.py",
  "main_process_port": 29500,
  "model_path": "models/Z-Image-Turbo",
  "trainer_args": {
    "context_label": "Privileged generation context:",
    "ema_decay": 0.9999,
    "loss_type": "velocity",
    "timesteps": [0.0, 0.1, 0.25, 0.5],
    "resolution": 1024,
    "student_max_sequence_length": 512,
    "teacher_max_sequence_length": 1024,
    "rank": 64,
    "lora_alpha": 128,
    "lora_dropout": 0.0,
    "train_batch_size": 1,
    "gradient_accumulation_steps": 1,
    "dataloader_num_workers": 8,
    "max_train_steps": 2000,
    "checkpointing_steps": 200,
    "resume_from_checkpoint": "latest",
    "learning_rate": 0.0001,
    "lr_scheduler": "constant",
    "lr_warmup_steps": 0,
    "adam_beta1": 0.9,
    "adam_beta2": 0.999,
    "adam_weight_decay": 0.0,
    "adam_epsilon": 1e-08,
    "max_grad_norm": 1.0,
    "mixed_precision": "bf16",
    "report_to": "wandb",
    "tracker_project_name": "zimage-dopcd",
    "parameter_logging_steps": 50,
    "seed": 42,
    "gradient_checkpointing": true,
    "allow_tf32": true
  },
  "environment": {
    "TRANSFORMERS_OFFLINE": "1",
    "HF_HUB_OFFLINE": "1",
    "TOKENIZERS_PARALLELISM": "false"
  }
}
